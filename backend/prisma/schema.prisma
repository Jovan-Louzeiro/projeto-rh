generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ENUM

enum TipoCTPS {
  ANTIGO
  NOVO
}

enum TipoContato {
  TELEFONE_FIXO
  TELEFONE_MOVEL
  EMAIL
}

enum TipoCertidao {
  NASCIMENTO
  CASAMENTO
}

enum PermissaoUsuario {
  ADMIN
  RH
}

enum TipoIdentidade {
  RG
  CIN
}

enum TipoDocumentoDigitalizado {
  CERTIDAO
  CNH
  CTPS
  IDENTIDADE
  TITULO_ELEITOR
}

enum SituacaoFerias {
  PENDENTE
  APROVADA
  CANCELADA
}

enum SituacaoLicenca {
  PENDENTE
  EM_ANALISE
  APROVADA
  REJEITADA
  EM_ANDAMENTO
  ENCERRADA
  CANCELADA
}

enum SituacaoQuinquenio {
  AGUARDANDO_CONCESSAO
  CONCEDIDO
  IMPLANTADO
  SUSPENSO
  CANCELADO
}

// Tabelas de Dominio Simples
model Sexo {
  id_sexo   Int     @id @default(autoincrement())
  descricao String  @unique @db.VarChar(10)
  ativo     Boolean @default(true)

  servidores Servidor[]
}

model Genero {
  id_genero Int     @id @default(autoincrement())
  descricao String  @unique @db.VarChar(20)
  ativo     Boolean @default(true)

  servidores Servidor[]
}

model RacaCor {
  id_racacor Int     @id @default(autoincrement())
  descricao  String  @unique @db.VarChar(10)
  ativo      Boolean @default(true)

  servidores Servidor[]
}

model ComunidadeIndigena {
  id_comunidade_indigena Int     @id @default(autoincrement())
  descricao              String  @unique @db.VarChar(50)
  ativo                  Boolean @default(true)

  servidores Servidor[]
}

model Escolaridade {
  id_escolaridade Int     @id @default(autoincrement())
  descricao       String  @unique @db.VarChar(50)
  ativo           Boolean @default(true)

  servidores Servidor[]
}

model Nivel {
  id_nivel  Int     @id @default(autoincrement())
  descricao String  @unique @db.VarChar(10)
  ativo     Boolean @default(true)
}

model EstadoCivil {
  id_estado_civil Int        @id @default(autoincrement())
  descricao       String     @unique @db.VarChar(15)
  ativo           Boolean    @default(true)
  servidores      Servidor[]
}

// Localização
model Pais {
  id_pais    Int     @id @default(autoincrement())
  nome       String  @unique @db.VarChar(100)
  gentilico  String  @db.VarChar(100)
  codigo_iso String  @unique @db.Char(2)
  ativo      Boolean @default(true)

  estados Estado[]

  servidores_nascimento    Servidor[] @relation("PaisOrigem")
  servidores_nacionalidade Servidor[] @relation("Nacionalidade")
}

model Estado {
  id_estado Int     @id @default(autoincrement())
  nome      String  @unique @db.VarChar(100)
  uf        String  @unique @db.Char(2)
  ativo     Boolean @default(true)

  pais_id Int
  pais    Pais @relation(fields: [pais_id], references: [id_pais])

  municipios Municipio[]
  identidade Identidade[] @relation("IdentidadeUF")
  ctps       CTPS[]       @relation("CtpsUf")
}

model Municipio {
  id_municipio Int     @id @default(autoincrement())
  nome         String  @db.VarChar(100)
  ativo        Boolean @default(true)

  estado_id Int
  estado    Estado @relation(fields: [estado_id], references: [id_estado])

  servidores_nascimento Servidor[] @relation("MunicipioNascimento")

  servidores_endereco Servidor[] @relation("MunicipioEndereco")

  @@unique([nome, estado_id])
}

model ZonaEndereco {
  id_zona_endereco Int     @id @default(autoincrement())
  descricao        String  @unique @db.VarChar(10)
  ativo            Boolean @default(true)

  servidores_endereco Servidor[] @relation("ZonaEndereco")
}

model LocalizacaoDiferenciada {
  id_localizacao_diferenciada Int     @id @default(autoincrement())
  descricao                   String  @unique @db.VarChar(50)
  ativo                       Boolean @default(true)

  servidores Servidor[]
}

// Dados Funcionais
model Cargo {
  id_cargo  Int     @id @default(autoincrement())
  descricao String  @unique @db.VarChar(50)
  ativo     Boolean @default(true)

  historicos_funcionais HistoricoFuncional[]
}

model Funcao {
  id_funcao Int     @id @default(autoincrement())
  descricao String  @unique @db.VarChar(50)
  ativo     Boolean @default(true)

  historicos_funcionais HistoricoFuncional[]
}

model Departamento {
  id_departamento Int     @id @default(autoincrement())
  descricao       String  @unique @db.VarChar(150)
  inep            String? @unique @db.VarChar(50)
  ativo           Boolean @default(true)

  historicos_funcionais HistoricoFuncional[]
}

model TipoVinculo {
  id_tipo_vinculo Int     @id @default(autoincrement())
  descricao       String  @unique @db.VarChar(50)
  ativo           Boolean @default(true)

  matriculas Matricula[]
}

model TipoEnsinoMedioCursado {
  id_tipo_ensino_medio_cursado Int     @id @default(autoincrement())
  descricao                    String  @unique @db.VarChar(50)
  ativo                        Boolean @default(true)

  servidores Servidor[]
}

model Situacao {
  id_situacao Int     @id @default(autoincrement())
  descricao   String  @unique @db.VarChar(30)
  ativo       Boolean @default(true)

  historico_funcional HistoricoFuncional[]
  servidor            Servidor[]
}

// Documentos

model Certidao {
  id_certidao Int @id @default(autoincrement())

  nova_certidao Boolean

  matricula     String       @db.VarChar(50)
  tipo_certidao TipoCertidao

  termo String? @db.VarChar(5)
  folha String? @db.VarChar(5)
  livro String? @db.VarChar(5)

  data_emissao DateTime

  servidor_id Int      @unique
  servidor    Servidor @relation(fields: [servidor_id], references: [id_servidor], onDelete: Cascade)
}

model CNH {
  id_cnh        Int      @id @default(autoincrement())
  numero        String   @unique @db.VarChar(11)
  categoria     String   @db.VarChar(15)
  data_emissao  DateTime
  data_validade DateTime

  servidor_id Int      @unique
  servidor    Servidor @relation(fields: [servidor_id], references: [id_servidor], onDelete: Cascade)
}

model CTPS {
  id_ctps Int @id @default(autoincrement())

  tipo_ctps TipoCTPS

  numero String? @db.VarChar(15)
  serie  String? @db.VarChar(5)

  uf_ctps_id Int?
  uf_ctps    Estado? @relation("CtpsUf", fields: [uf_ctps_id], references: [id_estado])

  data_emissao DateTime

  servidor_id Int      @unique
  servidor    Servidor @relation(fields: [servidor_id], references: [id_servidor], onDelete: Cascade)

  @@unique([numero, serie, uf_ctps_id])
}

model Identidade {
  id_identidade Int @id @default(autoincrement())

  tipo_identidade TipoIdentidade

  numero        String? @db.VarChar(30)
  orgao_emissor String  @db.VarChar(30)

  rg_uf_id Int
  rg_uf    Estado @relation("IdentidadeUF", fields: [rg_uf_id], references: [id_estado])

  rg_data_emissao DateTime

  servidor_id Int      @unique
  servidor    Servidor @relation(fields: [servidor_id], references: [id_servidor], onDelete: Cascade)

  @@unique([numero, orgao_emissor, rg_uf_id])
}

model TituloEleitor {
  id_titulo_eleitor Int @id @default(autoincrement())

  numero String @unique @db.VarChar(12)
  zona   String @db.VarChar(4)
  secao  String @db.VarChar(4)

  servidor_id Int      @unique
  servidor    Servidor @relation(fields: [servidor_id], references: [id_servidor], onDelete: Cascade)
}

//Saúde
model CID {
  id_cid Int     @id @default(autoincrement())
  codigo String  @unique @db.VarChar(10)
  ativo  Boolean @default(true)

  servidor_cid ServidorCid[]
}

model ServidorCid {
  id_servidor_cid Int     @id @default(autoincrement())
  ativo           Boolean @default(true)

  servidor_id Int
  servidor    Servidor @relation(fields: [servidor_id], references: [id_servidor])

  cid_id Int
  cid    CID @relation(fields: [cid_id], references: [id_cid])

  @@unique([servidor_id, cid_id])
}

model CursoFormacaoContinuada {
  id_curso_formacao_continuada Int     @id @default(autoincrement())
  descricao                    String  @unique @db.VarChar(50)
  ativo                        Boolean @default(true)

  servidores ServidorCursoFormacaoContinuada[]
}

model ServidorCursoFormacaoContinuada {
  id_servidor_curso_formacao_continuada Int     @id @default(autoincrement())
  ativo                                 Boolean @default(true)

  servidor_id Int
  servidor    Servidor @relation(fields: [servidor_id], references: [id_servidor])

  curso_formacao_continuada_id Int
  curso_formacao_continuada    CursoFormacaoContinuada @relation(fields: [curso_formacao_continuada_id], references: [id_curso_formacao_continuada])

  @@unique([servidor_id, curso_formacao_continuada_id])
}

model Contato {
  id_contato   Int         @id @default(autoincrement())
  tipo_contato TipoContato
  contato      String      @db.VarChar(150)
  principal    Boolean     @default(false)
  ativo        Boolean     @default(true)

  servidor_id Int
  servidor    Servidor @relation(fields: [servidor_id], references: [id_servidor], onDelete: Cascade)
}

model HistoricoFuncional {
  id_historico_funcional Int @id @default(autoincrement())

  matricula_id Int
  matricula    Matricula @relation(fields: [matricula_id], references: [id_matricula], onDelete: Cascade)

  cargo_id Int
  cargo    Cargo @relation(fields: [cargo_id], references: [id_cargo])

  funcao_id Int?
  funcao    Funcao? @relation(fields: [funcao_id], references: [id_funcao])

  departamento_id Int?
  departamento    Departamento? @relation(fields: [departamento_id], references: [id_departamento])

  situacao_historico_funcional_id Int
  situacao                        Situacao @relation(fields: [situacao_historico_funcional_id], references: [id_situacao])

  data_inicio DateTime
  data_fim    DateTime?
}

model Matricula {
  id_matricula Int     @id @default(autoincrement())
  ativo        Boolean @default(true)

  numero   String   @unique @db.VarChar(50)
  admissao DateTime

  tipo_vinculo_id Int
  tipo_vinculo    TipoVinculo @relation(fields: [tipo_vinculo_id], references: [id_tipo_vinculo])

  servidor_id Int
  servidor    Servidor @relation(fields: [servidor_id], references: [id_servidor], onDelete: Cascade)

  historicos_funcionais HistoricoFuncional[]

  requerimentos Requerimento[]
  ferias        Ferias[]
  licencas      Licenca[]
  quinquenios   Quinquenio[]
}

model Ferias {
  id_ferias Int @id @default(autoincrement())

  servidor_id Int
  servidor    Servidor @relation(fields: [servidor_id], references: [id_servidor], onDelete: Cascade)

  matricula_id Int?
  matricula    Matricula? @relation(fields: [matricula_id], references: [id_matricula], onDelete: SetNull)

  periodo_aquisitivo_inicio DateTime @db.Date
  periodo_aquisitivo_fim    DateTime @db.Date
  dias_direito              Int
  inicio                    DateTime @db.Date
  fim                       DateTime @db.Date
  dias                      Int
  abono_pecuniario           Boolean        @default(false)
  antecipacao_decimo_terceiro Boolean       @default(false)
  observacoes                String?        @db.VarChar(1000)
  situacao                   SituacaoFerias @default(PENDENTE)
  aprovado_em                DateTime?
  cancelado_em               DateTime?
  criado_em                  DateTime       @default(now())
  atualizado_em              DateTime       @updatedAt

  @@index([servidor_id])
  @@index([situacao])
  @@index([inicio, fim])
}

model Licenca {
  id_licenca Int @id @default(autoincrement())

  servidor_id Int
  servidor    Servidor @relation(fields: [servidor_id], references: [id_servidor], onDelete: Cascade)

  matricula_id Int?
  matricula    Matricula? @relation(fields: [matricula_id], references: [id_matricula], onDelete: SetNull)

  tipo                String         @db.VarChar(100)
  inicio              DateTime       @db.Date
  termino             DateTime?      @db.Date
  sem_data_termino    Boolean        @default(false)
  dias                Int?
  previsao_retorno    DateTime?      @db.Date
  numero_documento    String?        @db.VarChar(100)
  data_documento      DateTime?      @db.Date
  orgao_emissor       String?        @db.VarChar(150)
  observacoes         String?        @db.VarChar(2000)
  situacao            SituacaoLicenca @default(PENDENTE)
  criado_em           DateTime       @default(now())
  atualizado_em       DateTime       @updatedAt

  anexo LicencaAnexo?

  @@index([servidor_id])
  @@index([situacao])
  @@index([inicio, termino])
}

model LicencaAnexo {
  id_anexo_licenca Int      @id @default(autoincrement())
  nome              String   @db.VarChar(255)
  tipo              String   @db.VarChar(100)
  tamanho           Int
  conteudo          Bytes
  enviado_em        DateTime @default(now())

  licenca_id Int      @unique
  licenca    Licenca  @relation(fields: [licenca_id], references: [id_licenca], onDelete: Cascade)
}

model Quinquenio {
  id_quinquenio Int @id @default(autoincrement())

  servidor_id Int
  servidor    Servidor @relation(fields: [servidor_id], references: [id_servidor], onDelete: Cascade)

  matricula_id Int?
  matricula    Matricula? @relation(fields: [matricula_id], references: [id_matricula], onDelete: SetNull)

  numero                     Int
  data_admissao              DateTime @db.Date
  periodo_aquisitivo_inicio  DateTime @db.Date
  periodo_aquisitivo_fim     DateTime @db.Date
  data_aquisicao             DateTime @db.Date
  percentual_adicional       Float
  valor_calculado            Float
  data_inicio_pagamento      DateTime @db.Date
  situacao                   SituacaoQuinquenio @default(AGUARDANDO_CONCESSAO)
  ato_numero                 String @db.VarChar(100)
  ato_tipo                   String @db.VarChar(100)
  ato_data                   DateTime @db.Date
  observacoes                String? @db.VarChar(2000)
  cancelado_em               DateTime?
  criado_em                  DateTime @default(now())
  atualizado_em              DateTime @updatedAt

  anexo QuinquenioAnexo?

  @@unique([servidor_id, numero])
  @@index([servidor_id])
  @@index([situacao])
  @@index([data_aquisicao, data_inicio_pagamento])
}

model QuinquenioAnexo {
  id_anexo_quinquenio Int      @id @default(autoincrement())
  nome                String   @db.VarChar(255)
  tipo                String   @db.VarChar(100)
  tamanho             Int
  conteudo            Bytes
  enviado_em          DateTime @default(now())

  quinquenio_id Int        @unique
  quinquenio    Quinquenio @relation(fields: [quinquenio_id], references: [id_quinquenio], onDelete: Cascade)
}

model TiposLicenca {
  id_tipos_licenca Int     @id @default(autoincrement())
  ativo            Boolean @default(true)

  descricao String @db.VarChar(50)
}

model TipoRequerimento {
  id_tipo_requerimento Int     @id @default(autoincrement())
  ativo                Boolean @default(true)

  descricao String @db.VarChar(50)

  requerimentos Requerimento[]
}

model Requerimento {
  id_requerimento Int @id @default(autoincrement())

  numero_protocolo String @unique

  tipo_requerimento_id Int
  tipo_requerimento    TipoRequerimento @relation(fields: [tipo_requerimento_id], references: [id_tipo_requerimento])

  servidor_id Int
  servidor    Servidor @relation(fields: [servidor_id], references: [id_servidor])

  matricula_id Int
  matricula    Matricula @relation(fields: [matricula_id], references: [id_matricula])

  dados_historicos Json

  criado_em DateTime @default(now())

  anexos RequerimentoAnexo[]
}

model RequerimentoAnexo {
  id_anexo_requerimento Int      @id @default(autoincrement())
  nome                  String   @db.VarChar(255)
  tipo                  String   @db.VarChar(100)
  tamanho               Int
  conteudo              Bytes
  enviado_em            DateTime @default(now())
  assinado              Boolean  @default(false)

  requerimento_id Int
  requerimento    Requerimento @relation(fields: [requerimento_id], references: [id_requerimento], onDelete: Cascade)
}

model Usuario {
  id_usuario Int    @id @default(autoincrement())
  nome       String @db.VarChar(50)
  email      String @unique @db.VarChar(50)
  senha      String

  permissao PermissaoUsuario

  ativo Boolean @default(true)

  servidor_id Int?      @unique
  servidor    Servidor? @relation(fields: [servidor_id], references: [id_servidor])
}

model Servidor {
  id_servidor Int     @id @default(autoincrement())
  ativo       Boolean @default(true)

  // Identificação
  matriculas    Matricula[]
  nome_completo String      @db.VarChar(150)
  nome_social   String?     @db.VarChar(150)
  cpf           String      @unique @db.VarChar(11)

  nis_pis String? @unique @db.VarChar(20)

  // Nacimento / Nacionalidade
  data_nascimento DateTime

  nacionalidade_id Int
  nacionalidade    Pais @relation("Nacionalidade", fields: [nacionalidade_id], references: [id_pais])

  pais_origem_id Int?
  pais_origem    Pais? @relation("PaisOrigem", fields: [pais_origem_id], references: [id_pais])

  ano_chegada_brasil Int?

  municipio_nascimento_id Int?
  municipio_nascimento    Municipio? @relation("MunicipioNascimento", fields: [municipio_nascimento_id], references: [id_municipio])

  // Filiação
  cpf_mae  String? @db.VarChar(11)
  nome_mae String  @db.VarChar(150)
  cpf_pai  String? @db.VarChar(11)
  nome_pai String  @db.VarChar(150)

  // Estado Civil
  estado_civil_id Int?
  estado_civil    EstadoCivil? @relation(fields: [estado_civil_id], references: [id_estado_civil])

  uniao_estavel Boolean? @default(false)

  // Características
  sexo_id Int
  sexo    Sexo @relation(fields: [sexo_id], references: [id_sexo])

  genero_id Int?
  genero    Genero? @relation(fields: [genero_id], references: [id_genero])

  racacor_id Int
  racacor    RacaCor @relation(fields: [racacor_id], references: [id_racacor])

  comunidade_indigena_id Int?
  comunidade_indigena    ComunidadeIndigena? @relation(fields: [comunidade_indigena_id], references: [id_comunidade_indigena])

  // Contato
  contatos Contato[]

  // Endereço
  cep         String  @db.VarChar(8)
  logradouro  String  @db.VarChar(100)
  numero      String? @db.VarChar(10)
  complemento String? @db.VarChar(100)
  bairro      String  @db.VarChar(50)

  municipio_endereco_id Int
  municipio_endereco    Municipio @relation("MunicipioEndereco", fields: [municipio_endereco_id], references: [id_municipio])

  zona_endereco_id Int
  zona_endereco    ZonaEndereco @relation("ZonaEndereco", fields: [zona_endereco_id], references: [id_zona_endereco])

  localizacao_diferenciada_id Int?
  localizacao_diferenciada    LocalizacaoDiferenciada? @relation(fields: [localizacao_diferenciada_id], references: [id_localizacao_diferenciada])

  // Documentos
  certidao       Certidao?
  cnh            CNH?
  ctps           CTPS?
  identidade     Identidade?
  titulo_eleitor TituloEleitor?
  documentos_digitalizados DocumentoDigitalizadoServidor[]

  // Saúde
  cartao_sus   String?       @unique @db.VarChar(15)
  servidor_cid ServidorCid[]

  // Dados Funcionais
  situacao_id Int
  situacao    Situacao @relation(fields: [situacao_id], references: [id_situacao])

  requerimentos Requerimento[]
  ferias        Ferias[]
  licencas      Licenca[]
  quinquenios   Quinquenio[]

  escolaridade_id Int?
  escolaridade    Escolaridade? @relation(fields: [escolaridade_id], references: [id_escolaridade])

  tipo_ensino_medio_cursado_id Int?
  tipo_ensino_medio_cursado    TipoEnsinoMedioCursado? @relation(fields: [tipo_ensino_medio_cursado_id], references: [id_tipo_ensino_medio_cursado])

  // Curso de Formação Continuada
  cursos_formacao_continuada ServidorCursoFormacaoContinuada[]

  // Outros
  observacao String?  @db.VarChar(500)
  usuario    Usuario?
}

model DocumentoDigitalizadoServidor {
  id_documento_digitalizado Int                      @id @default(autoincrement())
  servidor_id               Int
  servidor                  Servidor                 @relation(fields: [servidor_id], references: [id_servidor], onDelete: Cascade)
  tipo                      TipoDocumentoDigitalizado
  nome                      String                   @db.VarChar(255)
  mime_type                 String                   @db.VarChar(100)
  tamanho                   Int
  conteudo                  Bytes
  enviado_em                DateTime                 @default(now())

  @@unique([servidor_id, tipo])
}
